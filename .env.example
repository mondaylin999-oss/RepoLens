# Optional. A GitHub personal access token (no scopes needed for public repos).
# Raises the API rate limit from 60 to 5,000 requests/hour. Server-side only — never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=

# Optional. Shown in the navbar and footer if set.
NEXT_PUBLIC_PROJECT_REPO_URL=

# Auth.js GitHub sign-in, account history, saved-repository sync, team workspaces,
# and shared API request limits (Neon PostgreSQL). Required in Vercel Production.
# GitHub OAuth callback: https://your-production-domain/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
DATABASE_URL=
